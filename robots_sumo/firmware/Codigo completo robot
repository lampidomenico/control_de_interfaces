
#include <stdio.h>
#include "pico/stdlib.h"
#include "hardware/pwm.h"

#define IN1 2
#define IN2 3
#define IN3 4
#define IN4 5

// Pines PWM para control de velocidad (deben ser pines con capacidad PWM)
#define ENA 6   // Habilita motor A (velocidad)
#define ENB 7   // Habilita motor B (velocidad)

uint slice_ena, slice_enb;

void setup_pwm(uint pin, uint *slice)
{
    gpio_set_function(pin, GPIO_FUNC_PWM);
    *slice = pwm_gpio_to_slice_num(pin);
    pwm_set_wrap(*slice, 255);      // Resolución 0-255 (8 bits)
    pwm_set_clkdiv(*slice, 100.0f); // Divisor de reloj, ajustá según necesites
    pwm_set_enabled(*slice, true);
}

void set_speed(uint slice, uint chan, uint8_t duty)
{
    pwm_set_chan_level(slice, chan, duty); // duty: 0 (apagado) a 255 (máxima velocidad)
}

void avanzar()
{
    gpio_put(IN1, 1);
    gpio_put(IN2, 0);
    gpio_put(IN3, 1);
    gpio_put(IN4, 0);
}

void detener()
{
    gpio_put(IN1, 0);
    gpio_put(IN2, 0);
    gpio_put(IN3, 0);
    gpio_put(IN4, 0);
}

int main()
{
    stdio_init_all();

    gpio_init(IN1);
    gpio_init(IN2);
    gpio_init(IN3);
    gpio_init(IN4);
    gpio_set_dir(IN1, GPIO_OUT);
    gpio_set_dir(IN2, GPIO_OUT);
    gpio_set_dir(IN3, GPIO_OUT);
    gpio_set_dir(IN4, GPIO_OUT);

    // Configurar PWM para control de velocidad
    setup_pwm(ENA, &slice_ena);
    setup_pwm(ENB, &slice_enb);

    while (true)
    {
        avanzar();

        // Ejemplo: rampa de velocidad de 0 a 255
        for (int duty = 0; duty <= 255; duty += 5)
        {
            set_speed(slice_ena, pwm_gpio_to_channel(ENA), duty);
            set_speed(slice_enb, pwm_gpio_to_channel(ENB), duty);
            sleep_ms(20);
        }

        sleep_ms(1000);

        detener();
        sleep_ms(1000);
    }
}
